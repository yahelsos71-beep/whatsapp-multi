{
  "name": "whatsapp-multi",
  "productName": "WhatsApp Multi",
  "version": "1.0.0",
  "description": "3 חשבונות וואטסאפ בתוכנה אחת עם צלצול להודעות",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
